# ─────────────────────────────────────────────────────────────
#  HydraPing — .gitignore
#  Note: HydraPing.spec IS tracked. It is the build definition,
#  not a build artifact, so it is deliberately not ignored here.
# ─────────────────────────────────────────────────────────────

# ── Python bytecode ──
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# ── Virtual environments ──
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version

# ── PyInstaller build output ──
# Regenerated by `pyinstaller HydraPing.spec`; the 46 MB exe in particular
# should never enter history, since it changes wholesale on every build.
build/
dist/
*.manifest
*.spec.bak
# PyInstaller derives an .ico from icon.png at build time
generated-*.ico

# ── Packaging / distribution ──
*.egg-info/
.eggs/
pip-wheel-metadata/
MANIFEST

# ── Runtime data ──
# The live database lives in %APPDATA%/HydraPing (see core/config.py), not in
# the repo. These rules only catch stray copies made while debugging.
*.db
*.sqlite
*.sqlite3
hydration.db
*.db-journal
*.db-wal
*.db-shm
logs/
*.log

# ── Secrets / local config ──
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# ── Test / lint / type-check caches ──
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Editors & IDEs ──
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.claude/

# ── Patch / backup leftovers ──
*.bak
*.orig
*.rej
*.tmp
*.temp

# ── OS noise ──
# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
# Linux
.directory
.Trash-*
